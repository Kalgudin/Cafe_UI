<LoyaltyScreen>:
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            size_hint_y: None
            height: 50
            SecondaryButton:
                text: '< Назад'
                size_hint_x: 0.35
                on_release: root.go_back()
            Label:
                text: 'Бонусы'
                font_size: 20
                bold: True
        RecycleView:
            viewclass: 'LoyaltyRow'
            data: root.rv_data
            RecycleBoxLayout:
                default_size: None, dp(50)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
        Label:
            text: 'Загрузка...' if root.loading else ''
            size_hint_y: None
            height: 25
            color: 0.4, 0.4, 0.4, 1